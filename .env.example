# ──────────────────────────────────────────────────────────────────
# Step Korean — Environment Variables Template
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.
# ──────────────────────────────────────────────────────────────────

# Firebase — get these from your Firebase project settings
# https://console.firebase.google.com → Project Settings → Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# FCM Web Push — Firebase Console → Project Settings → Cloud Messaging →
# "Web Push certificates" → generate a key pair, paste the public "Key pair" value.
# Required for the evening study reminder (client-side token registration).
VITE_FIREBASE_VAPID_KEY=

# ── Server-only (no VITE_ prefix) — used by api/send-reminders.js ──
# Triggered hourly by the free GitHub Actions scheduler
# (.github/workflows/send-reminders.yml), NOT a Vercel cron (which needs Pro).
# Full service-account JSON as a single string. Firebase Console →
# Project Settings → Service accounts → Generate new private key.
FIREBASE_SERVICE_ACCOUNT=
# Shared secret the scheduler sends as "Authorization: Bearer <CRON_SECRET>".
# Set the SAME value in: Vercel env var (here) AND GitHub repo →
# Settings → Secrets and variables → Actions → Secret CRON_SECRET.
CRON_SECRET=

# Public page URLs — safe to share but kept configurable
VITE_NOTION_URL=https://notion.so
VITE_PAYHIP_URL=https://payhip.com/StepKorean

# NVIDIA NIM (OpenAI SDK-compatible) — https://build.nvidia.com
# Server-only (no VITE_ prefix): powers api/explain-expression.js
NVIDIA_API_KEY=
# (선택) 모델 오버라이드 — 기본값 nvidia/nemotron-3-super-120b-a12b
# 이전 모델 llama-3.3-nemotron-super-49b-v1.5 는 2026-08-26 EOL(HTTP 410)로 폐기됨.
# 카탈로그: curl https://integrate.api.nvidia.com/v1/models -H "Authorization: Bearer $NVIDIA_API_KEY"
NVIDIA_QUIZ_MODEL=       # api/generate-quiz.js (퀴즈 생성)
NVIDIA_TRANSLATE_MODEL=  # explanation 번역 (api/_lib/explanationI18n.mjs, scripts/*)
